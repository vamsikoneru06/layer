# Postgres connection string (Neon in production).
DATABASE_URL=postgres://vash:vash@localhost:5432/vash
# Public origin of the app, no trailing slash.
APP_ORIGIN=http://localhost:3000
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# "true" only behind a proxy that overwrites X-Forwarded-For (Vercel).
TRUST_PROXY=false
# Optional "Continue with Google" (free) — set both or neither.
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application),
# redirect URI: <APP_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign-in emails. Development logs links to the console. Production needs one of the two below.
# Free: a Gmail address plus an App Password (myaccount.google.com/apppasswords; needs 2-Step Verification).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or Resend (its free plan only delivers to your own address until you verify a domain).
RESEND_API_KEY=
MAIL_FROM=
