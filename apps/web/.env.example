# Postgres connection string. In production use Neon's pooled string (host contains "-pooler"); the app refuses the direct one.
# The direct string is only for migrations and backups: it goes in the GitHub "production" environment as DATABASE_URL_UNPOOLED.
DATABASE_URL=postgres://vash:vash@localhost:5432/vash
# Public origin of the app, no trailing slash.
APP_ORIGIN=http://localhost:3000
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# "true" only behind a proxy that overwrites X-Forwarded-For (Vercel).
TRUST_PROXY=false
# Optional "Continue with Google" (free) — set both or neither.
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application),
# redirect URI: <APP_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign-in emails. Development logs links to the console. Production needs one of the two below.
# Free: a Gmail address plus an App Password (myaccount.google.com/apppasswords; needs 2-Step Verification).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or Resend (its free plan only delivers to your own address until you verify a domain).
RESEND_API_KEY=
MAIL_FROM=
# Public contact address shown on the Terms and Privacy pages and in /.well-known/security.txt
# (questions, data requests, complaints, vulnerability reports). Use a dedicated address, not a personal one.
CONTACT_EMAIL=
# Name of the Grievance Officer, required on the Terms and Privacy pages by India's IT Rules 2021.
GRIEVANCE_OFFICER_NAME=
# Photo storage: Supabase Storage via its S3 API (free, no card). Set all five, or none. Required in production; in development, without them photos are stored in the database (50 MB per user).
# Supabase → Project settings → Storage → S3 Connection (endpoint, region) and S3 Access Keys.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public bucket URL: https://<project-ref>.supabase.co/storage/v1/object/public/vash-public
STORAGE_PUBLIC_BASE_URL=
STORAGE_PRIVATE_BUCKET=vash-private
STORAGE_PUBLIC_BUCKET=vash-public
# 32+ random characters; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>". Required in production.
CRON_SECRET=
# Optional error reporting with Sentry (free Developer plan). Project settings → Client Keys (DSN).
# Unset: nothing is reported. Read at build time for the browser, so redeploy after changing it.
NEXT_PUBLIC_SENTRY_DSN=
# Pexels API key (free, pexels.com/api) for stock photo search in the editor. Without it, search is turned off.
PEXELS_API_KEY=
